manifest {
    name            = 'rddc-registry-to-phenopacket'
    description     = 'Prototype: registry exports (hierarchical JSON, wide CSV) to GA4GH Phenopackets v2 via LinkML-Map'
    mainScript      = 'main.nf'
    version         = '0.2.0'
    nextflowVersion = '!>=25.04.0'
}

params {
    sidecar          = null                                  // the batch's _sidecar.json (one registry export per batch)
    sources          = "${projectDir}/mappings/sources.yaml"  // registered mapping of each source (by sidecar sourceId)
    truth            = null                                  // ground-truth JSONL for the round-trip check (synthetic data only)
    outdir           = null
    assets           = "${projectDir}/assets"                 // curated tables + committed vocabulary subset
    vocab            = null                                  // release tables from `make vocab` (vocab/tables); default: assets
    hp_json          = null                                  // hp.json for OAK graph checks in validation
    strict_validation = true                                 // fail the run on validation errors
    target_schema    = "${projectDir}/schema/registry_record.yaml"
    pxf_jar          = null                                  // phenopacket-tools CLI jar; validation runs only when set
    strict_roundtrip = false                                 // fail the run if any record fails the round-trip check
}

includeConfig 'conf/base.config'

process {
    // Built from ./Dockerfile (make image); published with `make push-image`. Cirro pulls it.
    container = 'ghcr.io/sage-bionetworks/rddc-registry-to-phenopacket:0.2.0.dev0'
}

profiles {
    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    // No container: the uv virtualenv (make tools) and java on PATH.
    local {
        process.container = null
        env.PATH          = "${projectDir}/.venv/bin:\$PATH"
    }
    // Synthetic fixtures from bin/gen_registry_data.py, strict round-trip.
    test {
        // One batch per run: the NORD-like batch by default; `make nf-test` runs both.
        params.sidecar          = "${projectDir}/tests/data/nordlike/_sidecar.json"
        params.truth            = "${projectDir}/tests/data/truth.jsonl"
        params.outdir           = 'results'
        params.strict_roundtrip = true
        process.resourceLimits  = [cpus: 2, memory: 4.GB, time: 1.h]
    }
}
